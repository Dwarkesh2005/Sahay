          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }],
            "url": { "raw": "{{BASE_URL}}/admin/requests", "host": ["{{BASE_URL}}"], "path": ["admin", "requests"] }
          }
        },
        {
          "name": "5.6 Get Reports (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }],
            "url": { "raw": "{{BASE_URL}}/admin/reports", "host": ["{{BASE_URL}}"], "path": ["admin", "reports"] }
          }
