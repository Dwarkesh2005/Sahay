            "method": "GET",
            "url": { "raw": "{{BASE_URL}}/cities", "host": ["{{BASE_URL}}"], "path": ["cities"] }
          }
        }
      ]
    },
    {
      "name": "7. NGO Document Verification & Admin Review",
      "item": [
        {
          "name": "7.1 Get My Verification Status (NGO)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('verification');",
                  "    if (json.verification && json.verification.verification_id) {",
                  "        pm.collectionVariables.set('VERIFICATION_ID', json.verification.verification_id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{NGO_TOKEN}}" }],
            "url": { "raw": "{{BASE_URL}}/ngos/verification", "host": ["{{BASE_URL}}"], "path": ["ngos", "verification"] }
