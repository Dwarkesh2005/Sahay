generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model chats {
  chat_id       Int           @id @default(autoincrement())
  request_id    Int
  responder_id  Int
  created_at    DateTime?     @default(now()) @db.Timestamp(6)
  help_requests help_requests @relation(fields: [request_id], references: [request_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_request")
  users         users         @relation(fields: [responder_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_responder")
  messages      messages[]

  @@unique([request_id, responder_id], map: "unique_chat")
}

model cities {
  city_id       Int             @id @default(autoincrement())
  city_name     String          @db.VarChar(100)
  district      String          @db.VarChar(100)
  state         String          @db.VarChar(100)
  help_requests help_requests[]
  ngos          ngos[]
  users         users[]

  @@unique([city_name, district, state], map: "unique_city")
}

model help_requests {
  request_id        Int                 @id @default(autoincrement())
  user_id           Int
  request_type      request_type
  title             String              @db.VarChar(150)
  description       String
  city_id           Int
  latitude          Decimal?            @db.Decimal(10, 8)
  longitude         Decimal?            @db.Decimal(11, 8)
  status            request_status?     @default(PENDING)
  urgency           String?             @default("MEDIUM")
  expires_at        DateTime?           @db.Timestamp(6)
  completed_at      DateTime?           @db.Timestamp(6)
  accepted_ngo_id   Int?
  parent_request_id Int?
  renewal_number    Int                 @default(0)
  last_reminder_at  DateTime?           @db.Timestamp(6)
  reminder_count    Int                 @default(0)
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  updated_at        DateTime?           @default(now()) @db.Timestamp(6)
  chats             chats[]
  cities            cities              @relation(fields: [city_id], references: [city_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_request_city")
  users             users               @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_request_user")
  accepted_ngo      ngos?               @relation("AcceptedNgoRequests", fields: [accepted_ngo_id], references: [ngo_id], onDelete: SetNull, onUpdate: NoAction, map: "fk_request_accepted_ngo")
  parent_request    help_requests?      @relation("RequestRenewals", fields: [parent_request_id], references: [request_id], onDelete: SetNull, onUpdate: NoAction, map: "fk_request_parent")
  renewed_requests  help_requests[]     @relation("RequestRenewals")
  request_responses request_responses[]
  need_ngo_requests need_ngo_requests[]

  @@index([user_id])
  @@index([status])
  @@index([city_id])
  @@index([expires_at])
  @@index([status, expires_at])
}

model messages {
  message_id Int       @id @default(autoincrement())
  chat_id    Int
  sender_id  Int
  message    String
  sent_at    DateTime? @default(now()) @db.Timestamp(6)
  is_read    Boolean?  @default(false)
  chats      chats     @relation(fields: [chat_id], references: [chat_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_message_chat")
  users      users     @relation(fields: [sender_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_message_sender")
}

model ngo_services {
  service_id Int          @id @default(autoincrement())
  ngo_id     Int
  service    service_type
  ngos       ngos         @relation(fields: [ngo_id], references: [ngo_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_service_ngo")

  @@unique([ngo_id, service], map: "unique_ngo_service")
}

model ngo_verification {
  verification_id     Int       @id @default(autoincrement())
  ngo_id              Int
  verification_method String    @db.VarChar(100)
  verified_by         String?   @db.VarChar(100)
  verification_date   DateTime? @default(dbgenerated("CURRENT_DATE")) @db.Date
  remarks             String?
  ngos                ngos      @relation(fields: [ngo_id], references: [ngo_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_verification_ngo")
}

model ngos {
  ngo_id              Int                  @id @default(autoincrement())
  user_id             Int                  @unique
  ngo_name            String               @db.VarChar(255)
  registration_number String?              @unique @db.VarChar(100)
  ngo_darpan_id       String?              @unique @db.VarChar(100)
  contact_person      String               @db.VarChar(100)
  phone_number        String?              @db.VarChar(15)
  email               String?              @db.VarChar(255)
  website             String?
  pan                 String?              @db.VarChar(10)
  city_id             Int
  address             String
  latitude            Decimal?             @db.Decimal(10, 8)
  longitude           Decimal?             @db.Decimal(11, 8)
  verification_status verification_status? @default(PENDING)
  description         String?
  created_at          DateTime?            @default(now()) @db.Timestamp(6)
  updated_at          DateTime?            @default(now()) @db.Timestamp(6)
  ngo_services        ngo_services[]
  ngo_verification    ngo_verification[]
  ngo_doc_verification ngo_doc_verification?
  ngo_verification_documents ngo_verification_documents[]
  ngo_verification_audit_log ngo_verification_audit_log[]
  cities              cities               @relation(fields: [city_id], references: [city_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ngo_city")
  users               users                @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ngo_user")
  reports             reports[]
  need_ngo_requests   need_ngo_requests[]
  accepted_help_requests help_requests[] @relation("AcceptedNgoRequests")
}

model reports {
  report_id  Int            @id @default(autoincrement())
  ngo_id     Int
  user_id    Int
  reason     String
  status     report_status? @default(PENDING)
  created_at DateTime?      @default(now()) @db.Timestamp(6)
  ngos       ngos           @relation(fields: [ngo_id], references: [ngo_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_report_ngo")
  users      users          @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_report_user")
}

model request_responses {
  response_id      Int              @id @default(autoincrement())
  request_id       Int
  responder_id     Int
  response_message String
  response_time    DateTime?        @default(now()) @db.Timestamp(6)
  status           response_status? @default(ACCEPTED)
  help_requests    help_requests    @relation(fields: [request_id], references: [request_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_response_request")
  users            users            @relation(fields: [responder_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_response_user")

  @@unique([request_id, responder_id], map: "unique_response")
}

model users {
  user_id           Int                 @id @default(autoincrement())
  full_name         String              @db.VarChar(100)
  email             String              @unique @db.VarChar(255)
  phone_number      String?             @unique @db.VarChar(15)
  password_hash     String
  role              user_role
  city_id           Int?
  address           String?
  latitude          Decimal?            @db.Decimal(10, 8)
  longitude         Decimal?            @db.Decimal(11, 8)
  profile_photo     String?
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  updated_at        DateTime?           @default(now()) @db.Timestamp(6)
  is_active         Boolean?            @default(true)
  is_verified       Boolean?            @default(false)
  chats             chats[]
  help_requests     help_requests[]
  messages          messages[]
  ngos              ngos?
  reports           reports[]
  request_responses request_responses[]
  notifications     notifications[]
  verification_audit_logs ngo_verification_audit_log[]
  cities            cities?             @relation(fields: [city_id], references: [city_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([role])
}

enum report_status {
  PENDING
  REVIEWED
  RESOLVED
}

enum request_status {
  PENDING
  ACCEPTED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum request_type {
  FOOD
  SHELTER
  MEDICAL
  EMPLOYMENT
  GUIDANCE
}

enum response_status {
  ACCEPTED
  REJECTED
  COMPLETED
}

enum service_type {
  FOOD
  SHELTER
  MEDICAL
  EMPLOYMENT
  EDUCATION
  LEGAL
  GUIDANCE
  OTHER
  SKILL_DEVELOPMENT
  FINANCIAL_ASSISTANCE
  WOMEN_SUPPORT
  CHILD_SUPPORT
  ELDERLY_SUPPORT
  DISABILITY_SUPPORT
  MIGRANT_SUPPORT
  DOCUMENTATION
  EMERGENCY
}

enum user_role {
  MIGRANT
  VOLUNTEER
  NGO
  ADMIN
}

enum verification_status {
  PENDING
  GOVERNMENT_VERIFIED
  CONTACT_VERIFIED
  MANUALLY_VERIFIED
}

model ngo_doc_verification {
  verification_id      Int                      @id @default(autoincrement())
  ngo_id               Int                      @unique
  status               doc_verification_status  @default(NOT_SUBMITTED)
  screening_score      Decimal?                 @db.Decimal(5, 2)
  total_matches        Int                      @default(0)
  total_mismatches     Int                      @default(0)
  total_not_found      Int                      @default(0)
  ocr_confidence_avg   Decimal?                 @db.Decimal(5, 4)
  admin_notes          String?
  submitted_at         DateTime?                @db.Timestamp(6)
  processed_at         DateTime?                @db.Timestamp(6)
  reviewed_at          DateTime?                @db.Timestamp(6)
  reviewed_by          Int?
  created_at           DateTime?                @default(now()) @db.Timestamp(6)
  updated_at           DateTime?                @default(now()) @db.Timestamp(6)

  ngos                 ngos                     @relation(fields: [ngo_id], references: [ngo_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_doc_verif_ngo")
  documents            ngo_verification_documents[]
  fields               ngo_verification_fields[]
  issues               ngo_verification_issues[]
  audit_logs           ngo_verification_audit_log[]
}

model ngo_verification_documents {
  document_id          Int                      @id @default(autoincrement())
  verification_id      Int
  ngo_id               Int
  document_type        document_type
  original_filename    String                   @db.VarChar(255)
  stored_filename      String                   @db.VarChar(255)
  file_path            String                   @db.VarChar(500)
  file_size            Int
  mime_type            String                   @db.VarChar(100)
  file_hash            String                   @db.VarChar(64)
  version              Int                      @default(1)
  is_active            Boolean?                 @default(true)
  status               document_status          @default(UPLOADED)
  ocr_confidence       Decimal?                 @db.Decimal(5, 4)
  ocr_raw_text         String?
  quality_score        Decimal?                 @db.Decimal(5, 4)
  quality_issues       String?
  processing_error     String?
  created_at           DateTime?                @default(now()) @db.Timestamp(6)
  updated_at           DateTime?                @default(now()) @db.Timestamp(6)

  verification         ngo_doc_verification    @relation(fields: [verification_id], references: [verification_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_doc_verif_id")
  ngos                 ngos                     @relation(fields: [ngo_id], references: [ngo_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_doc_verif_doc_ngo")
  fields               ngo_verification_fields[]
  issues               ngo_verification_issues[]
}

model ngo_verification_fields {
  field_id             Int                      @id @default(autoincrement())
  verification_id      Int
  document_id          Int?
  field_name           String                   @db.VarChar(100)
  submitted_value      String?
  extracted_value      String?
  normalized_submitted String?
  normalized_extracted String?
  match_result         match_result
  confidence           Decimal?                 @db.Decimal(5, 4)
  importance           field_importance         @default(MEDIUM)
  source_page          Int?
  extraction_notes     String?
  created_at           DateTime?                @default(now()) @db.Timestamp(6)

  verification         ngo_doc_verification    @relation(fields: [verification_id], references: [verification_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_field_verif_id")
  document             ngo_verification_documents? @relation(fields: [document_id], references: [document_id], onDelete: SetNull, onUpdate: NoAction, map: "fk_field_doc_id")
}

model ngo_verification_issues {
  issue_id             Int                      @id @default(autoincrement())
  verification_id      Int
  document_id          Int?
  issue_type           String                   @db.VarChar(100)
  severity             String                   @db.VarChar(50)
  description          String
  field_name           String?                  @db.VarChar(100)
  created_at           DateTime?                @default(now()) @db.Timestamp(6)

  verification         ngo_doc_verification    @relation(fields: [verification_id], references: [verification_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_issue_verif_id")
  document             ngo_verification_documents? @relation(fields: [document_id], references: [document_id], onDelete: SetNull, onUpdate: NoAction, map: "fk_issue_doc_id")
}

model ngo_verification_audit_log {
  log_id               Int                      @id @default(autoincrement())
  verification_id      Int
  ngo_id               Int
  admin_id             Int?
  action               String                   @db.VarChar(100)
  previous_status      String?                  @db.VarChar(50)
  new_status           String?                  @db.VarChar(50)
  reason               String?
  screening_score      Decimal?                 @db.Decimal(5, 2)
  metadata             Json?
  created_at           DateTime?                @default(now()) @db.Timestamp(6)

  verification         ngo_doc_verification    @relation(fields: [verification_id], references: [verification_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_audit_verif_id")
  ngos                 ngos                     @relation(fields: [ngo_id], references: [ngo_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_audit_ngo_id")
  admin_user           users?                   @relation(fields: [admin_id], references: [user_id], onDelete: SetNull, onUpdate: NoAction, map: "fk_audit_admin_id")
}

enum doc_verification_status {
  NOT_SUBMITTED
  DOCUMENTS_REQUIRED
  DOCUMENTS_UPLOADED
  PROCESSING
  PROCESSING_FAILED
  AUTO_REVIEW_READY
  NEEDS_ADMIN_REVIEW
  NEEDS_CORRECTION
  APPROVED
  REJECTED
}

enum document_type {
  REGISTRATION_CERTIFICATE
  PAN_DOCUMENT
  TRUST_REGISTRATION
  SOCIETY_REGISTRATION
  SECTION_8_CERTIFICATE
  TWELVE_A_CERTIFICATE
  EIGHTY_G_CERTIFICATE
  ADDRESS_PROOF
  AUTHORIZED_REPRESENTATIVE_PROOF
  OTHER
}

enum document_status {
  UPLOADED
  VALIDATING
  PROCESSING
  PROCESSED
  FAILED
}

enum match_result {
  MATCH
  PARTIAL_MATCH
  MISMATCH
  NOT_FOUND
  NOT_APPLICABLE
  LOW_CONFIDENCE
}

enum field_importance {
  HIGH
  MEDIUM
  LOW
}

enum ngo_request_status {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

model need_ngo_requests {
  id                Int                @id @default(autoincrement())
  need_id           Int
  ngo_id            Int
  status            ngo_request_status @default(PENDING)
  sent_at           DateTime           @default(now()) @db.Timestamp(6)
  responded_at      DateTime?          @db.Timestamp(6)
  rejection_reason  String?
  last_reminder_at  DateTime?          @db.Timestamp(6)
  reminder_count    Int                @default(0)

  need              help_requests      @relation(fields: [need_id], references: [request_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_need_ngo_req_need")
  ngo               ngos               @relation(fields: [ngo_id], references: [ngo_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_need_ngo_req_ngo")

  @@unique([need_id, ngo_id], map: "unique_need_ngo_request")
  @@index([ngo_id, status])
  @@index([need_id])
}

model notifications {
  notification_id   Int       @id @default(autoincrement())
  user_id           Int
  title             String    @db.VarChar(200)
  message           String
  type              String    @db.VarChar(50)
  reference_id      Int?
  reference_type    String?   @db.VarChar(50)
  is_read           Boolean   @default(false)
  created_at        DateTime? @default(now()) @db.Timestamp(6)

  users             users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notification_user")

  @@index([user_id, is_read])
  @@index([user_id, created_at(sort: Desc)])
}
